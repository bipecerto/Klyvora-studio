# Chave única de acesso ao site (sem contas/login — só uma senha compartilhada)
SITE_ACCESS_KEY=

# Groq API (roteiro e quebra de cenas — LLM rápido e gratuito/barato)
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (geração de imagem das cenas via FLUX)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Banco de imagens de stock (opcional — usado em "Buscar imagem de stock")
STOCK_API_KEY=

# Supabase — OPCIONAL. Sem essas variáveis o app funciona 100% em modo local
# (dados ficam salvos no navegador do usuário via localStorage). Só preencha
# se você quiser persistência em banco de dados real / múltiplos dispositivos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
