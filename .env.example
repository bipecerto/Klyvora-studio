# Groq API (roteiro e quebra de cenas — LLM rápido e gratuito/barato)
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (geração de imagem das cenas via FLUX)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Banco de imagens de stock (opcional — usado em "Buscar imagem de stock")
STOCK_API_KEY=

# Supabase — Auth + Postgres
# NEXT_PUBLIC_* precisam existir porque são lidas no navegador (client components)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
